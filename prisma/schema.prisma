generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  REP
}

enum Channel {
  INSTAGRAM
  WHATSAPP
}

enum WaitlistSource {
  IG_DM
  IG_COMMENT
  STOREFRONT
  WHATSAPP
}

enum WaitlistStatus {
  WAITING
  ALERTED
  REPLIED
  BOUGHT
  STOPPED
}

enum OrderStatus {
  PENDING    // checkout started, not paid yet
  PAID       // money held in SafePay, waiting for the shop to dispatch
  SHIPPED
  DELIVERED  // shop says delivered; auto-release clock is running
  DISPUTED   // buyer reported a problem; money frozen until an admin decides
  RELEASED   // paid out to the shop
  REFUNDED
  CANCELLED  // never paid
}

enum ConversationSource {
  ORGANIC
  ALERT
}

enum ConversationStatus {
  OPEN
  WON
  LOST
}

enum Direction {
  IN
  OUT
}

enum Author {
  BUYER
  REP
  SYSTEM
}

model Shop {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  igHandle          String?
  whatsappNumber    String?  // public order number, E.164 digits, for wa.me links
  missLimitMinutes  Int      @default(60)
  bankDetails       String?
  // Meta connection. Tokens are encrypted at rest (see src/lib/crypto.ts).
  waPhoneNumberId   String?  @unique
  waTokenEnc        String?
  igAccountId       String?  @unique
  igTokenEnc        String?
  // SafePay payouts. The account name comes from the bank lookup, never typed by the vendor.
  payoutBankCode      String?
  payoutBankName      String?
  payoutAccountNumber String?
  payoutAccountName   String?
  paystackRecipient   String?
  // Business verification: the shop submits its CAC registration, Oja staff check it and approve.
  cacNumber              String?
  registeredName         String?
  verificationRequestedAt DateTime?
  businessVerifiedAt     DateTime?
  verificationNote       String?
  // Delivery booking: where riders collect from. The code is Shipbubble's id for the checked address.
  pickupAddress     String?
  pickupCity        String?
  pickupPhone       String?
  pickupAddressCode Int?
  createdAt         DateTime @default(now())

  users         User[]
  products      Product[]
  contacts      Contact[]
  conversations Conversation[]
  orders        Order[]
}

model User {
  id            String   @id @default(cuid())
  shopId        String
  shop          Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name          String
  email         String   @unique
  passwordHash  String
  role          Role     @default(REP)
  active        Boolean  @default(true)
  // Staff WhatsApp number (E.164 digits). Messages from it to the shop's number are product commands, not buyer chats.
  phone         String?
  // Product the last staff command or demand nudge was about, so "restock 12" needs no product name.
  lastProductId String?
  createdAt     DateTime @default(now())

  conversations Conversation[]
  messages      Message[]

  @@unique([shopId, phone])
}

model Product {
  id         String   @id @default(cuid())
  shopId     String
  shop       Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name       String
  priceKobo  Int
  stock      Int      @default(0)
  imageUrl   String?
  archived   Boolean  @default(false)
  // Set when the product was made from an Instagram post whose caption had no price.
  needsPrice Boolean  @default(false)
  igMediaId  String?
  // Waitlist size the owner was last told about (see demandMilestone).
  nudgedFor  Int      @default(0)
  createdAt  DateTime @default(now())

  image         ProductImage?
  waitlist      WaitlistEntry[]
  conversations Conversation[]
  orders        Order[]

  @@index([shopId])
  @@unique([shopId, igMediaId])
}

/// Photos sent over WhatsApp or copied from Instagram (Meta's media links expire), served at /api/products/:id/image.
model ProductImage {
  productId String  @id
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  mime      String
  data      Bytes
}

model Contact {
  id          String   @id @default(cuid())
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name        String
  waPhone     String?  // E.164 digits without "+", e.g. 2348031234567
  igUserId    String?  // Instagram-scoped user id
  igUsername  String?
  waOptedOut  Boolean  @default(false)
  createdAt   DateTime @default(now())

  waitlist      WaitlistEntry[]
  conversations Conversation[]

  @@unique([shopId, waPhone])
  @@unique([shopId, igUserId])
}

model WaitlistEntry {
  id          String         @id @default(cuid())
  productId   String
  product     Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  contactId   String
  contact     Contact        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  source      WaitlistSource
  status      WaitlistStatus @default(WAITING)
  consentText String
  consentAt   DateTime       @default(now())
  alertedAt   DateTime?
  createdAt   DateTime       @default(now())

  @@unique([productId, contactId])
  @@index([productId, status, createdAt])
}

model Conversation {
  id            String             @id @default(cuid())
  shopId        String
  shop          Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  contactId     String
  contact       Contact            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  channel       Channel
  repId         String?
  rep           User?              @relation(fields: [repId], references: [id], onDelete: SetNull)
  productId     String?
  product       Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)
  source        ConversationSource @default(ORGANIC)
  status        ConversationStatus @default(OPEN)
  startedAt     DateTime           @default(now())
  firstReplyAt  DateTime?
  lastBuyerAt   DateTime           @default(now())
  amountKobo    Int?
  closedAt      DateTime?

  messages Message[]

  @@index([shopId, status])
  @@index([shopId, startedAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      Direction
  author         Author
  repId          String?
  rep            User?        @relation(fields: [repId], references: [id], onDelete: SetNull)
  text           String
  externalId     String?      @unique
  // sent | delivered | read | failed | simulated
  deliveryStatus String?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model Order {
  id             String      @id @default(cuid())
  shopId         String
  shop           Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  reference      String      @unique // sent to Paystack
  buyerToken     String      @unique // secret in the buyer's tracking link
  buyerName      String
  buyerPhone     String      // E.164 digits
  buyerEmail     String?
  address        String
  city           String
  itemName       String
  quantity       Int
  amountKobo     Int         // items
  feeKobo        Int         // buyer protection fee
  totalKobo      Int         // what the buyer pays
  status         OrderStatus @default(PENDING)
  simulated      Boolean     @default(false) // paid in test mode, no real money moved
  paidAt         DateTime?
  shippedAt      DateTime?
  courier        String?
  trackingNote   String?
  deliveredAt    DateTime?
  releaseAt      DateTime?   // auto-release time, set when marked delivered
  disputedAt     DateTime?
  disputeReason  String?
  disputeDetail  String?
  resolvedAt     DateTime?
  resolutionNote String?
  // pending | success | failed | simulated | awaiting_account
  payoutStatus   String?
  payoutKobo     Int?
  payoutRef      String?     @unique
  // Delivery booked through Oja. The fee comes out of the shop's payout.
  buyerAddressCode Int?
  deliveryQuote    Json?     // latest prices: { token, at, couriers[] }
  shipmentId       String?   @unique
  shipmentStatus   String?   // booking | pending | confirmed | picked_up | in_transit | completed | cancelled
  trackingUrl      String?
  shippingKobo     Int       @default(0)
  createdAt      DateTime    @default(now())

  @@index([shopId, status])
  @@index([status, releaseAt])
}
