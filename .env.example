# Postgres connection string (Supabase: Project settings > Database > Connection string, "Transaction" pooler for Vercel)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/oja"

# Long random string used to sign login sessions. Generate with: openssl rand -base64 32
SESSION_SECRET=""

# 32-byte key, base64, used to encrypt each shop's Meta access tokens. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=""

# Public URL of the deployed app, e.g. https://oja.vercel.app
APP_URL="http://localhost:3000"

# From your Meta developer app (developers.facebook.com > App settings > Basic)
META_APP_SECRET=""
# Any string you choose; paste the same value into the webhook settings in the Meta app
META_WEBHOOK_VERIFY_TOKEN=""
# Graph API version
META_GRAPH_VERSION="v21.0"

# Name and language of the approved WhatsApp message template for restock alerts.
# Body must take 4 variables: {{1}} product, {{2}} shop name, {{3}} units left, {{4}} price
WA_RESTOCK_TEMPLATE="back_in_stock"
WA_TEMPLATE_LANG="en"

# Template that tells the shop owner how many buyers are waiting for a sold-out item.
# Body must take 2 variables: {{1}} number waiting, {{2}} product, e.g.
# "{{1}} people are waiting for {{2}}. Reply with how many you have when it's back, e.g. 10."
WA_DEMAND_TEMPLATE="waitlist_demand"

# ---------- SafePay (escrow checkout) ----------
# Paystack secret key (dashboard > Settings > API Keys & Webhooks). Leave empty for test mode: orders are
# marked paid without real money so the whole flow can be tried. Webhook URL: APP_URL/api/webhooks/paystack
PAYSTACK_SECRET_KEY=""
# Oja's cut of each order (basis points, 200 = 2%), the flat buyer protection fee (kobo, 30000 = ₦300),
# hours after delivery before money auto-releases, and hours a shop has to dispatch before the buyer can cancel.
SAFEPAY_COMMISSION_BPS="200"
SAFEPAY_BUYER_FEE_KOBO="30000"
SAFEPAY_RELEASE_HOURS="48"
SAFEPAY_DISPATCH_HOURS="72"
# Any long random string. Vercel Cron sends it to /api/cron/release, which pays out delivered orders.
CRON_SECRET=""
# Comma-separated login emails of Oja staff who can settle disputes (they see a Disputes tab).
ADMIN_EMAILS=""
# Optional approved WhatsApp template for order updates. Body: {{1}} shop name, {{2}} the update, {{3}} tracking link
WA_ORDER_TEMPLATE=""

# ---------- AI drafts ----------
# Anthropic API key (console.anthropic.com). Turns on "Draft reply with AI" and follow-up drafts in chats.
ANTHROPIC_API_KEY=""

# ---------- Delivery booking ----------
# Shipbubble API key (app.shipbubble.com > Settings > API keys; sb_sandbox_... for testing, sb_prod_... live).
# Leave empty for test mode: example prices and no rider is sent. Fund the Shipbubble wallet before going live;
# each booking is paid from it and taken out of that shop's payout. Webhook URL: APP_URL/api/webhooks/shipbubble
SHIPBUBBLE_API_KEY=""
# Package category name to match in Shipbubble's list (default "Fashion")
SHIPBUBBLE_CATEGORY="Fashion"
